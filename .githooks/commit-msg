#!/bin/bash
# Refuse a commit message that cannot be traced back to one task.
#
# A Git hook, not a runtime tool hook, because the message may arrive by -m, by
# -F, by stdin, or from an editor, and only this hook sees all of them. It
# applies to a person's commits as well as an agent's.
#
# The rules here are the mechanically checkable part of
# docs/git.md. Whether a commit covers
# one task is a semantic property no hook can decide; a vague subject is the
# cheapest honest proxy, because a commit that lumps several tasks together
# cannot be given a specific subject.

set -uo pipefail

# These hooks are Jarvis's own. They began as copies of the hooks Friday
# ships to projects and are maintained here on their own since 2026-10-24, so
# a refusal points at this repository's rules, not at another repository's.
doc_of() {
  printf '%s\n' "docs/git.md"
}


PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}"
export PATH

msg_file=${1:-}
[ -n "$msg_file" ] && [ -r "$msg_file" ] || { echo "COMMIT REFUSED: no message file" >&2; exit 1; }

refuse() {
  echo "COMMIT REFUSED: $1" >&2
  echo "" >&2
  echo "Nothing was committed. The message is preserved; fix it and commit again." >&2
  echo "Format rules: $(doc_of git-commit.md)" >&2
  echo "Do not reach for --no-verify: the collaborative Git guard refuses it." >&2
  exit 1
}

# Comments and trailing blanks are not part of the message.
body_all=$(grep -v '^#' "$msg_file" | awk 'BEGIN{b=0} {lines[NR]=$0} END{for(i=NR;i>=1;i--) if(lines[i] ~ /[^[:space:]]/){last=i;break} for(i=1;i<=last;i++) print lines[i]}')
subject=$(printf '%s\n' "$body_all" | head -1)

[ -n "${subject//[[:space:]]/}" ] || refuse "the message is empty"

# A merge or revert message is generated by Git; do not second-guess its shape.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"Reapply "*) exit 0 ;;
  "Initial commit") exit 0 ;;
esac

# 1. Conventional Commits prefix.
printf '%s' "$subject" \
  | grep -Eq '^(feat|fix|docs|refactor|test|chore|build|ci|perf|style)(\([a-z0-9][a-z0-9._/-]*\))?!?: .+' \
  || refuse "the subject is not Conventional Commits. Use 'type(scope): summary' with a type from feat, fix, docs, refactor, test, chore, build, ci, perf, style. Got: $subject"

# 2. Subject length. 50 is the target, 72 the hard cap.
# Characters, not bytes, and whatever the locale. Under a C/POSIX locale -- a
# GUI client, cron, some CI and IDEs -- ${#subject} counts bytes, so a 37-
# character Chinese subject (99 bytes) was refused as "99 characters". Count
# every byte that does not continue a UTF-8 sequence: one per character.
subject_len=$(printf '%s' "$subject" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d ' ')
[ "$subject_len" -le 72 ] \
  || refuse "the subject is $subject_len characters; the hard cap is 72 (target 50)"

# 3. No trailing period, imperative-ish.
case "$subject" in
  *.) refuse "the subject ends with a period" ;;
esac

summary=${subject#*: }
# No case rule. A refusal on `^[a-z]` rejected far more than capitals -- a
# proper noun (README, GitHub), a `code` name, a number, any summary not in
# English. A note in its place could not tell "Add" from "English" or
# "Python" either, and it printed "the commit goes ahead" just before another
# rule refused the same message. Case is style; git-commit.md keeps it as a
# preference, and this hook enforces only what traceability needs.
printf '%s' "$summary" | grep -Eqi '^(added|adds|fixed|fixes|updated|updates|changed|changes|removed|removes|refactored|created|creates)[[:space:]]' \
  && refuse "use the imperative: 'add', not 'added'/'adds'. Got: $summary"

# 4. A vague summary is the signal that a commit covers more than one thing.
# These words are what a message reaches for when no specific subject fits.
#
# Applied only when the vague word leads the summary, or when the summary is so
# short that the word carries it. Measured against real history: words like
# "fixes" and "changes" are legitimate objects of a specific verb -- "sync
# shared guard fixes" names its task perfectly well -- and refusing those would
# teach people to bypass the hook, which is worse than not having it.
vague='(misc|miscellaneous|various|stuff|things|cleanup|clean[[:space:]]?up|updates|tweaks|fixes|changes|wip|minor|small|several|multiple|assorted|etc)'
summary_words=$(printf '%s' "$summary" | wc -w | tr -d ' ')
if printf '%s' "$summary" | grep -Eqi "^$vague([[:space:]]|$)" \
  || { [ "$summary_words" -le 3 ] \
       && printf '%s' "$summary" | grep -Eqi "(^|[[:space:]])$vague([[:space:]]|\$)"; }; then
  refuse "the summary is too vague to trace to one task: '$summary'. A commit that needs a word like this usually covers more than one task -- split it. If it genuinely is one task, name what changed."
fi
printf '%s' "$summary" | grep -Eqi '[[:space:]](and[[:space:]]also|and[[:space:]]then|plus[[:space:]]also)[[:space:]]' \
  && refuse "the summary joins separate changes: '$summary'. Split them into one commit per task."

# 5. A substantial change needs a body saying why. The diff shows what.
body=$(printf '%s\n' "$body_all" | tail -n +2 | grep -v '^[[:space:]]*$' \
  | grep -Ev '^(Co-Authored-By|Co-authored-by|Signed-off-by|Refs|Closes|Fixes|Task|Reviewed-by):' || true)
if [ -z "${body//[[:space:]]/}" ]; then
  changed=$(git diff --cached --numstat 2>/dev/null | awk '{a+=$1; d+=$2} END{print (a+d)+0}')
  : "${changed:=0}"
  [ "$changed" -le 40 ] \
    || refuse "this commit changes $changed lines with no body. Say why the change exists; the diff already shows what. (A body is optional under 40 changed lines.)"
fi

# 6. The second line must be blank when a body follows.
second=$(printf '%s\n' "$body_all" | sed -n '2p')
if [ "$(printf '%s\n' "$body_all" | wc -l | tr -d ' ')" -gt 1 ] && [ -n "${second//[[:space:]]/}" ]; then
  refuse "put a blank line between the subject and the body"
fi

exit 0
